diff --git a/frontend/src/utils/bestScoreStorage.test.js b/frontend/src/utils/bestScoreStorage.test.js
index 0bfd25e..ab8be17 100644
--- a/frontend/src/utils/bestScoreStorage.test.js
+++ b/frontend/src/utils/bestScoreStorage.test.js
@@ -15,3 +15,13 @@ test("pickBestScore ignores invalid current", () => {
