+
+test("regression: recorded best is not replaced by a lower score", () => {
+  const recordedBest = 8;
+  const worseAttempt = 6;
+  assert.equal(
+    pickBestScore(recordedBest, worseAttempt),
+    recordedBest,
+    "must use max semantics, not min"
+  );
+});
