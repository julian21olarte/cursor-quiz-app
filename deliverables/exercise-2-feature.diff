diff --git a/frontend/src/utils/bestScoreStorage.js b/frontend/src/utils/bestScoreStorage.js
new file mode 100644
index 0000000..0aa2b71
--- /dev/null
+++ b/frontend/src/utils/bestScoreStorage.js
@@ -0,0 +1,45 @@
+const STORAGE_KEY = "cursor-quiz-best-scores";
+
+export function pickBestScore(previous, currentScore) {
+  if (typeof currentScore !== "number" || Number.isNaN(currentScore)) {
+    return previous ?? null;
+  }
+  if (previous == null) return currentScore;
+  return Math.max(previous, currentScore);
+}
+
+function readAll() {
+  try {
+    const raw = localStorage.getItem(STORAGE_KEY);
+    if (!raw) return {};
+    const parsed = JSON.parse(raw);
+    return typeof parsed === "object" && parsed !== null ? parsed : {};
+  } catch {
+    return {};
+  }
+}
+
+function writeAll(map) {
+  try {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify(map));
+  } catch {
+    /* quota / private mode — ignore */
+  }
+}
+
+export function getBestScore(quizId) {
+  if (!quizId) return null;
+  const value = readAll()[quizId];
+  return typeof value === "number" ? value : null;
+}
+
+export function saveBestScoreIfHigher(quizId, score) {
+  if (!quizId) return getBestScore(quizId);
+  const map = readAll();
+  const next = pickBestScore(map[quizId] ?? null, score);
+  if (next !== map[quizId]) {
+    map[quizId] = next;
+    writeAll(map);
+  }
+  return next;
+}
diff --git a/frontend/src/utils/bestScoreStorage.test.js b/frontend/src/utils/bestScoreStorage.test.js
new file mode 100644
index 0000000..0bfd25e
--- /dev/null
+++ b/frontend/src/utils/bestScoreStorage.test.js
@@ -0,0 +1,17 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { pickBestScore } from "./bestScoreStorage.js";
+
+test("pickBestScore returns current when no previous", () => {
+  assert.equal(pickBestScore(null, 4), 4);
+});
+
+test("pickBestScore keeps higher score", () => {
+  assert.equal(pickBestScore(5, 3), 5);
+  assert.equal(pickBestScore(2, 5), 5);
+});
+
+test("pickBestScore ignores invalid current", () => {
+  assert.equal(pickBestScore(3, NaN), 3);
+  assert.equal(pickBestScore(null, "x"), null);
+});
